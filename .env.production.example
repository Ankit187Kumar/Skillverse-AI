# Copy to .env next to docker-compose.yml. Never commit the real file.
DOMAIN=skillverse.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-generate-with-python-secrets-token_urlsafe-48

# AI model: Ollama container (--profile local-ai) or a hosted OpenAI-compatible API
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Research agent web search (--profile search), or brave / tavily with an API key
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080

# Coding lab sandbox (--profile sandbox); then run backend/scripts/piston_setup.py once
CODE_RUNNER=piston
PISTON_URL=http://piston:2000

# Voice (--profile voice) — or keep "browser" to use the browser's speech APIs
STT_PROVIDER=browser
# STT_PROVIDER=openai_compatible
# STT_BASE_URL=http://speaches:8000/v1
# STT_MODEL=Systran/faster-whisper-small
TTS_PROVIDER=browser
