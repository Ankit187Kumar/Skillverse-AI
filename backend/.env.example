# Copy to backend/.env and adjust. Never commit the real .env file.

ENVIRONMENT=development            # development | production

# Database — SQLite for the MVP. For PostgreSQL:
#   pip install "psycopg[binary]" and use postgresql+psycopg://user:pass@host:5432/skillverse
DATABASE_URL=sqlite:///./skillverse.db

# Session signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
SESSION_MINUTES=10080              # 7 days
COOKIE_SECURE=false                # must be true in production (HTTPS)

# Only needed if the browser calls the API directly instead of through the Next.js proxy
CORS_ORIGINS=http://localhost:3000

# ---- AI model ----
LLM_PROVIDER=ollama                # ollama | openai_compatible
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.4

# Ollama (local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b           # see README "Choosing a model" for RAM guidance
OLLAMA_NUM_CTX=8192

# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding model for document search (Research Agent). Falls back to keyword search if missing.
EMBEDDING_MODEL=nomic-embed-text   # ollama pull nomic-embed-text

# ---- Background jobs ----
JOB_WORKERS=2

# ---- Research agent web search ----
SEARCH_PROVIDER=none               # none | searxng | brave | tavily
SEARXNG_URL=http://localhost:8888
BRAVE_API_KEY=
TAVILY_API_KEY=
RESEARCH_MAX_SOURCES=8
RESEARCH_CONTEXT_CHARS=12000       # passages sent to the model; raise for large-context models
ALLOW_PRIVATE_FETCH=false          # keep false: blocks fetching internal/private addresses (SSRF)

# ---- Coding lab sandbox (user code never runs on this server) ----
CODE_RUNNER=none                   # none | piston | judge0
PISTON_URL=http://localhost:2000
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
CODE_RUN_TIMEOUT_MS=3000
CODE_MEMORY_LIMIT_MB=256

# ---- Voice ----
STT_PROVIDER=browser               # none | browser | openai_compatible
STT_BASE_URL=http://localhost:8001/v1
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-small
TTS_PROVIDER=browser               # browser | openai_compatible
TTS_BASE_URL=http://localhost:8001/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
MAX_AUDIO_MB=10

# ---- Uploads and rate limits ----
MAX_UPLOAD_MB=5
MAX_DOCUMENT_MB=15
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
